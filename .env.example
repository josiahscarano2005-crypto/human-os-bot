# Copy this file to .env and fill in real values. NEVER commit .env.
# Get the token from @BotFather in Telegram (revoke the old one first).
TELEGRAM_BOT_TOKEN=paste_new_token_here

# Your personal chat id (a number, e.g. 123456789).
TELEGRAM_CHAT_ID=paste_chat_id_here

# Optional overrides.
HUMAN_OS_TZ=America/New_York
HUMAN_OS_DRY_RUN=0
